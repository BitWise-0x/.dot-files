
Include ~/.colima/ssh_config


# VisualHostKey=yes

# LAN hosts that get reimaged/re-keyed often: skip host-key checks there only.
# Scope to your own internal domains/ranges; never apply this to Host *.
# Example:
#Host *.example.lan *.local 10.0.0.* 192.168.*
#    StrictHostKeyChecking no
#    UserKnownHostsFile /dev/null

# Globals
Host *
    #Port 22
    StrictHostKeyChecking accept-new
    IdentityFile ~/.ssh/id_rsa
    #ServerAliveInterval 60
    #ServerAliveCountMax 30

#Host server-1
    #Hostname server-1.mydomain.com
    #User ec2-user
    #IdentityFile ~/.keys/mykey.pem
